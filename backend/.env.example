PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/studygenie-ai
JWT_SECRET=replace-with-a-long-random-secret
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Or provide the complete service-account JSON as one secret instead:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=StudyGenie AI <no-reply@example.com>
NODE_ENV=development
# Absolute path to a working Python 3.10+ executable used by the optional RAG bridge.
# Example (Windows): C:\\Users\\your-name\\AppData\\Local\\Programs\\Python\\Python311\\python.exe
PYTHON_BIN=C:\Users\your-name\AppData\Local\Programs\Python\Python311\python.exe
# Timeout (ms) for the chat/RAG Python subprocess (a single quick Q&A turn).
# Materials generation uses its own, longer ceiling: MATERIALS_AI_TIMEOUT_MS below.
PYTHON_AI_TIMEOUT_MS=180000
RAG_ANSWER_CACHE_TTL_MS=600000
RAG_ANSWER_CACHE_MAX_ENTRIES=100
PERSISTENT_AI_WORKER=true
# Provider selection. `groq` is the fast hosted default once GROQ_API_KEY is set;
# OpenRouter and the previous local llama.cpp/Qwen path remain explicit fallbacks.
# Valid values: groq, openrouter, local. `NEW_FAST_LLM` is accepted as a groq alias.
LLM_PROVIDER=groq
# Groq is OpenAI-compatible and runs the model remotely; no local GPU/model load is needed.
# Create a free Groq API key, keep it in your local .env, and never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_TEMPERATURE=0.2
# `low` avoids the GPT-OSS default medium reasoning latency while preserving grounded RAG prompts.
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=2048
# Optional fallback provider; only used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=45
# Optional local llama.cpp OpenAI-compatible provider; only used when LLM_PROVIDER=local.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=ggml-org/Qwen3.5-0.8B-GGUF
# Optional. When omitted on Windows, StudyGenie uses the default executable path
# C:\\Users\\naras\\Downloads\\llama-b10336-bin-win-cpu-x64\\llama.exe
LOCAL_LLM_EXECUTABLE=C:\\Users\\your-name\\Downloads\\llama-b10336-bin-win-cpu-x64\\llama.exe
# Optional local .gguf path. If omitted, LOCAL_LLM_MODEL is passed as --hf-repo.
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_STARTUP_TIMEOUT_MS=120000
LOCAL_LLM_HEALTH_TIMEOUT_MS=3000
LOCAL_LLM_RESTART_DELAY_MS=3000
LOCAL_LLM_MAX_TOKENS=1000
LOCAL_LLM_TEMPERATURE=0.2
# Legacy name for the request read timeout; LLM_REQUEST_TIMEOUT (below) wins when set.
LOCAL_LLM_TIMEOUT=45
# --- llama.cpp runtime tuning (passed to the managed server at startup) ---
# Bounded KV-cache context window. Without it, llama.cpp loads the model's full
# trained context (262k for Qwen), so an oversized prompt is silently accepted and
# evaluated on CPU — a root cause of materials-generation timeouts. Set 0 to omit.
LOCAL_LLM_CTX_SIZE=8192
# Optional CPU threads / batch size / parallel slots. Only emitted when set (> 0);
# leave blank to let llama.cpp choose its own defaults.
LOCAL_LLM_THREADS=
LOCAL_LLM_BATCH_SIZE=
LOCAL_LLM_PARALLEL=
# Reasoning ("thinking") mode. Qwen3-family models think by default; llama.cpp puts
# that trace in message.reasoning_content and leaves message.content empty until it
# closes. A small CPU model can burn its whole max_tokens budget thinking, returning
# empty content (finish_reason=length) that reads as a failure. Keep "off" for
# structured study-material/RAG generation; use on|auto only to debug.
LOCAL_LLM_REASONING=off
# --- Per-operation LLM timeouts (seconds) so a slow-but-working model is not
# treated like an unreachable one, and a long notes job is not killed like a chat.
# connect: fast TCP reachability probe; request: normal chat/Q&A/quiz read timeout;
# notes: longer read timeout for whole-document notes generation.
LLM_CONNECT_TIMEOUT=10
LLM_REQUEST_TIMEOUT=45
NOTES_LLM_TIMEOUT=240
# Max output tokens for notes generation — more than a chat answer, still bounded.
NOTES_LLM_MAX_TOKENS=1536
# Overall ceiling (ms) for one materials-generation subprocess (notes [+ Q&A/quiz]).
MATERIALS_AI_TIMEOUT_MS=300000
# --- RAG-first generation policy ---
# Retrieve first, generate second. When false (default), PDF setup only extracts
# text + indexes chunks into the vector store; notes/flashcards/quiz are produced
# only when the user explicitly requests them. Set true to restore the legacy
# upload->auto-generate behaviour.
AUTO_GENERATE_ON_SETUP=false
# Online-search fallback for PDF questions whose retrieved context is insufficient.
# Architecture-ready but disabled: with no provider configured, an insufficient
# PDF question is reported honestly rather than answered from the web.
ALLOW_ONLINE_SEARCH=false
# Conservative PDF figure selection. IMAGE_MAX_RESULTS is a ceiling, not a quota;
# a question with no strong figure receives an empty image list.
IMAGE_RELEVANCE_THRESHOLD=0.68
IMAGE_MAX_RESULTS=2
IMAGE_RETRIEVAL_DEBUG=false
# ChromaDB is the only supported vector database for the Python RAG pipeline.
# Prefer an ABSOLUTE path in production so the store resolves the same regardless
# of the process working directory (the relative default below is cwd-relative).
CHROMA_PERSIST_DIRECTORY=./vector_db/chroma
CHROMA_COLLECTION_NAME=studygenie_documents
VECTOR_DIMENSION=384
# Vector-store retrieval knobs (read by ai/retrieval/vector_store.py).
VECTOR_TOP_K=5
VECTOR_SCORE_THRESHOLD=0.35
# Adaptive-RAG knobs (read by ai/generation/rag_service.py).
RAG_MAX_CONTEXT_CHUNKS=5
RAG_RELEVANCE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=6000
RAG_CONTEXT_MAX_TOKENS=2200
RAG_MIN_RELEVANT_CHUNKS=1
# --- Retrieval recall/relevance decoupling (read by ai/retrieval/retrieval_service.py
# and ai/generation/rag_service.py). All optional; the defaults below reproduce the
# previous behaviour EXACTLY, so this block is safe to omit. ---
# THE RECALL FLOOR IS NOT THE RELEVANCE THRESHOLD. The recall stage's job is to
# return the top_k nearest candidates so grading can see them; a hard cosine floor
# there silently discarded every candidate for broad/short/paraphrased queries
# (symptom: retrieved=0, best_score=0.00, evidence=none even though the PDF was
# indexed). Keep this at 0.0 so recall returns the top_k ordering intact; the actual
# keep/drop relevance decision still happens in classify_evidence using
# RAG_RELEVANCE_THRESHOLD above. Raise ONLY to prune obvious noise from recall.
RAG_RECALL_SCORE_THRESHOLD=0.0
# Partial-evidence band. Score at/above which mid-relevance evidence may be GROUNDED
# and used as a PARTIAL (rag_supported=true, labelled partial) answer instead of
# dropped to "none". Defaults to RAG_RELEVANCE_THRESHOLD when blank (identical
# behaviour). It is clamped to never exceed RAG_RELEVANCE_THRESHOLD, so the
# "sufficient" bar is unaffected; lower it only to allow honest partial grounding of
# mid-score evidence. Leave blank to keep the default.
RAG_PARTIAL_SCORE_THRESHOLD=
# Warm the local embedding model once at RAG start-up so the FIRST query does not pay
# the model cold-start (~69s observed, folded into the first retrieve_ms). Best-effort
# and non-blocking; set false to restore pure lazy-load on first use.
RAG_WARMUP_ON_INIT=true
# Optional: force the embedding model to load only from the local HuggingFace cache
# (no network hub check at load time). Uncomment after the model has been cached once
# to trim cold-start latency and make offline start-up deterministic.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# Context budget for AI study-material generation (notes / Q&A / quiz). Notes
# summarise the WHOLE document, so chunks are sampled evenly across it up to these
# caps instead of sending the entire PDF. NOTES_CONTEXT_MAX_CHARS falls back to
# RAG_MAX_CONTEXT_CHARS when unset.
NOTES_CONTEXT_MAX_CHARS=8000
NOTES_CONTEXT_MAX_CHUNKS=12
# Python AI log level for the structured JSON logs (DEBUG/INFO/WARNING/ERROR).
AI_LOG_LEVEL=INFO

# --- High-capacity RAG funnel + Q&A-batch tuning (read by ai/generation/rag_service.py
# and ai/main.py). All optional: leaving a key unset reproduces the previous
# single-top_k behaviour exactly, so this block is safe to omit entirely. ---
# The funnel is STORE EVERYTHING (upload-time chunking, unchanged) -> RETRIEVE MANY
# -> RERANK -> EXPAND -> SELECT. These knobs only widen retrieval/rerank; the text
# actually handed to the LLM is still capped by RAG_MAX_CONTEXT_CHARS (chat) or the
# 10-mark char floor below, so widening them is CPU-cheap and does not blow up the
# prompt or the per-answer latency.
#
# Base funnel (chat + general RAG):
#   RETRIEVAL_TOP_K = vector-store candidates returned      (retrieve many)
#   HYBRID_TOP_K    = survivors of semantic+keyword hybrid   (rank)
#   RERANK_TOP_K    = survivors of cross-encoder rerank       (select few)
#   CONTEXT_NEIGHBORS = +/-N document-order neighbours per match (expand for coherence)
RAG_RETRIEVAL_TOP_K=30
RAG_HYBRID_TOP_K=60
RAG_RERANK_TOP_K=25
RAG_CONTEXT_NEIGHBORS=2
# 10-mark / Q&A-batch overrides — these WIN when question_type=10_mark. Slightly
# wider retrieval for exam-grade grounding; hybrid width held at 60 to bound
# cross-encoder cost across a 20-question batch.
RAG_TEN_MARK_RETRIEVAL_TOP_K=40
RAG_TEN_MARK_HYBRID_TOP_K=60
RAG_TEN_MARK_RERANK_TOP_K=30
RAG_TEN_MARK_CONTEXT_NEIGHBORS=2
# Per-answer output-token budgets. RAG_QA_ANSWER_MAX_TOKENS caps each answer in the
# 20-question Q&A batch so the whole set stays within the subprocess timeout;
# RAG_TEN_MARK_MAX_TOKENS is the single-answer /generate 10_mark budget.
RAG_QA_ANSWER_MAX_TOKENS=800
RAG_TEN_MARK_MAX_TOKENS=1500
# --- Q&A question-generation batch tuning (read by ai/generation/qa_generator.py) ---
# The 20+ distinct question STRINGS are produced BEFORE any answers, in small
# reliable batches with a top-up loop that repeats until the min-20 target is met
# (or the material is exhausted). Small batches keep each request fast and well
# inside the read timeout; one large ask makes a small CPU model ramble past the
# token cap and time out — the prior root cause of stalled Q&A generation. All
# de-duplication is enforced in code, so batching never changes the min-20 contract,
# question coverage, or answer quality; it only affects generation speed/reliability.
#   QA_QUESTION_BATCH_SIZE     = questions requested per generation round.
#   QA_QUESTION_GEN_MAX_TOKENS = output-token cap PER round. It must stay large
#     enough to hold BATCH_SIZE questions as JSON, so RAISE THIS WHENEVER YOU RAISE
#     THE BATCH SIZE — otherwise the last questions in a round are truncated and lost.
#   QA_QUESTION_STALE_LIMIT    = stop after this many consecutive rounds that add no
#     new distinct question (material exhausted); bounds a runaway to ~seconds.
QA_QUESTION_BATCH_SIZE=6
QA_QUESTION_GEN_MAX_TOKENS=768
QA_QUESTION_STALE_LIMIT=4
QA_ANSWER_BATCH_SIZE=2
# Overall ceiling (ms) for one Q&A-batch subprocess (20+ sequential 10-mark answers
# on a local CPU model). Falls back to MATERIALS_AI_TIMEOUT_MS when unset.
MATERIALS_QA_TIMEOUT_MS=1800000
# NOTE: chat context (RAG_MAX_CONTEXT_CHARS=6000 above) is kept modest to preserve
# interactive chat latency; the 10-mark path automatically uses
# max(RAG_MAX_CONTEXT_CHARS, 9000) chars of grounded context. On GPU / a larger model
# you can raise RAG_MAX_CONTEXT_CHARS (and RAG_MAX_CONTEXT_CHUNKS) for richer context.
